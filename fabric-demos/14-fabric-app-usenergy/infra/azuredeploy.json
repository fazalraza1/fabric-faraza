{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the Storage account and Key Vault."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "usenergy",
      "minLength": 3,
      "maxLength": 12,
      "metadata": {
        "description": "Short lowercase prefix used to name deployed resources."
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "demo",
      "allowedValues": [
        "dev",
        "test",
        "demo",
        "prod"
      ],
      "metadata": {
        "description": "Environment label applied to resource names and tags."
      }
    },
    "eiaApiKey": {
      "type": "secureString",
      "metadata": {
        "description": "U.S. EIA Open Data API key. Stored as an Azure Key Vault secret."
      }
    },
    "censusApiKey": {
      "type": "secureString",
      "metadata": {
        "description": "U.S. Census Data API key. Stored as an Azure Key Vault secret."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Optional tags merged with the project tags."
      }
    }
  },
  "variables": {
    "safePrefix": "[take(replace(replace(toLower(parameters('namePrefix')), '-', ''), '_', ''), 12)]",
    "suffix": "[uniqueString(subscription().id, resourceGroup().id, variables('safePrefix'), parameters('environment'))]",
    "projectTags": "[union(createObject('application', 'fabric-app-usenergy', 'environment', parameters('environment'), 'dataClassification', 'public', 'managedBy', 'bicep'), parameters('tags'))]",
    "storageName": "[take(format('st{0}{1}', variables('safePrefix'), variables('suffix')), 24)]",
    "keyVaultName": "[take(format('kv-{0}-{1}', variables('safePrefix'), variables('suffix')), 24)]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('projectTags')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "accessTier": "Hot",
        "allowBlobPublicAccess": false,
        "allowCrossTenantReplication": false,
        "allowSharedKeyAccess": false,
        "defaultToOAuthAuthentication": true,
        "isHnsEnabled": true,
        "minimumTlsVersion": "TLS1_2",
        "publicNetworkAccess": "Enabled",
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/default', variables('storageName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ],
      "properties": {
        "deleteRetentionPolicy": {
          "enabled": true,
          "days": 7
        },
        "containerDeleteRetentionPolicy": {
          "enabled": true,
          "days": 7
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/default/raw', variables('storageName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageName'), 'default')]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('projectTags')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "enablePurgeProtection": true,
        "enableRbacAuthorization": true,
        "enabledForDeployment": false,
        "enabledForDiskEncryption": false,
        "enabledForTemplateDeployment": false,
        "publicNetworkAccess": "Enabled",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "softDeleteRetentionInDays": 90
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/eia-api-key', variables('keyVaultName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
      ],
      "properties": {
        "value": "[parameters('eiaApiKey')]"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/census-api-key', variables('keyVaultName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
      ],
      "properties": {
        "value": "[parameters('censusApiKey')]"
      }
    }
  ],
  "outputs": {
    "keyVaultName": {
      "type": "string",
      "value": "[variables('keyVaultName')]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), '2023-07-01').vaultUri]"
    },
    "rawContainerName": {
      "type": "string",
      "value": "raw"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageName')]"
    },
    "storageBlobEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), '2023-05-01').primaryEndpoints.blob]"
    }
  }
}
